<Window x:Class="DashboardMonitorBateraiManajemen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DashboardMonitorBateraiManajemen"
        xmlns:vm="clr-namespace:DashboardMonitorBateraiManajemen.ViewModels"
        xmlns:conv="clr-namespace:DashboardMonitorBateraiManajemen.Converters"
        mc:Ignorable="d"
        Title="BMS TELEMETRY // RS-232 MONITOR" 
        Height="760" Width="1280"
        MinHeight="600" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource FgPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI, Roboto, Helvetica, Arial">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Monochrome Button Style -->
        <Style x:Key="MonoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgCardHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource FgPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource FgInverse}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style (Inverted Solid) -->
        <Style x:Key="MonoPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FgPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource FgInverse}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FgPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Item Style -->
        <Style x:Key="MonoComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter TextElement.Foreground="{DynamicResource FgPrimary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BgCardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="MonoComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{DynamicResource FgSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource FgPrimary}" />
                    <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource FgPrimary}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBox Style -->
        <Style x:Key="MonoComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MonoComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource MonoComboBoxToggleButtonTemplate}" />

                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="10,0,30,0"
                                              IsHitTestVisible="False"
                                              TextBlock.Foreground="{DynamicResource FgPrimary}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        Background="{DynamicResource BgCard}"
                                        BorderBrush="{DynamicResource BorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="4">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Top Header & Connection Bar -->
            <RowDefinition Height="Auto" />
            <!-- KPI Top Row (5 Metrics Cards) -->
            <RowDefinition Height="Auto" />
            <!-- Main Analytics & Waveform View -->
            <RowDefinition Height="*" />
            <!-- Bottom RS232 Terminal Console -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: HEADER & SERIAL CONTROLS                                           -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand & Info -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Serial Controls -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Theme & Tools -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand Badge -->
                    <Border Background="{DynamicResource FgPrimary}" 
                            CornerRadius="4" 
                            Width="36" Height="36" 
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource IconChip}" 
                              Fill="{DynamicResource FgInverse}" 
                              Stretch="Uniform" 
                              Width="20" Height="20" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BMS TELEMETRY" FontWeight="Black" FontSize="16" />
                            <Border Margin="10,0,0,0" 
                                    Background="{DynamicResource AccentMuted}" 
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="MQTT / WOKWI / SERIAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Battery Management &amp; Capacity (Ah) Monitoring System" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource FgSecondary}" 
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Center-Right: Mode Selector, MQTT / Serial Controls & Connection -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Connection Mode Selector -->
                    <ComboBox Width="145"
                              ItemsSource="{Binding ConnectionModes}"
                              SelectedItem="{Binding SelectedConnectionMode}"
                              Style="{StaticResource MonoComboBoxStyle}"
                              Margin="0,0,8,0"
                              ToolTip="Pilih Mode Koneksi: MQTT (Wokwi / IoT) atau SERIAL (COM)" />

                    <!-- 1. MQTT Controls (Visible when IsMqttMode) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsMqttMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Broker Input / Dropdown -->
                        <ComboBox Width="135"
                                  IsEditable="True"
                                  ItemsSource="{Binding AvailableBrokers}"
                                  Text="{Binding MqttBroker, Mode=TwoWay}"
                                  Style="{StaticResource MonoComboBoxStyle}"
                                  Margin="0,0,6,0"
                                  ToolTip="Alamat Broker MQTT (default: broker.emqx.io)" />
                        <!-- Topic Input -->
                        <TextBox Width="120" Height="34"
                                 Text="{Binding MqttTopic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgCardAlt}"
                                 Foreground="{DynamicResource FgPrimary}"
                                 BorderBrush="{DynamicResource BorderCard}"
                                 BorderThickness="1"
                                 Padding="8,6"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,0"
                                 ToolTip="Topic MQTT (default: sic/bms/telemetry)" />
                    </StackPanel>

                    <!-- 2. Serial Controls (Visible when IsSerialMode) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Port Dropdown -->
                        <ComboBox Width="110"
                                  ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}"
                                  Style="{StaticResource MonoComboBoxStyle}"
                                  Margin="0,0,6,0"
                                  ToolTip="Pilih Port Serial Virtual (misal COM1 atau COM2)" />
                        <!-- Refresh Ports Button -->
                        <Button Click="BtnRefreshPorts_Click"
                                Style="{StaticResource MonoButtonStyle}" 
                                Padding="8,8" 
                                Margin="0,0,6,0"
                                ToolTip="Segarkan Daftar Port COM">
                            <Path Data="{StaticResource IconRefresh}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="12" Height="12" 
                                  Stretch="Uniform" />
                        </Button>
                        <!-- Baud Rate Dropdown -->
                        <ComboBox Width="85"
                                  ItemsSource="{Binding BaudRates}"
                                  SelectedItem="{Binding SelectedBaudRate}"
                                  Style="{StaticResource MonoComboBoxStyle}"
                                  Margin="0,0,12,0"
                                  ToolTip="Baud Rate Serial" />
                    </StackPanel>

                    <!-- Connect / Disconnect Button -->
                    <Button Click="BtnConnect_Click"
                            Content="{Binding ConnectionButtonText}"
                            Style="{StaticResource MonoPrimaryButtonStyle}"
                            Margin="0,0,12,0" />

                    <!-- Status Pill Indicator -->
                    <Border BorderBrush="{DynamicResource BorderCard}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Background="{DynamicResource BgCardAlt}"
                            Padding="10,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Indicator Circle -->
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource FgDimmed}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource FgPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatusBadge}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource FgSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Simulation & Theme Toggles -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Simulation Toggle -->
                    <Button Click="BtnSimulation_Click"
                            Style="{StaticResource MonoButtonStyle}" 
                            Margin="0,0,8,0"
                            ToolTip="Nyalakan/Matikan Simulasi Fluktuasi Sensor Otomatis">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="10" Height="10" 
                                  Stretch="Uniform" 
                                  Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SimulationButtonText}" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Dark / Light Mode Switcher -->
                    <Button Click="BtnToggleTheme_Click"
                            Style="{StaticResource MonoButtonStyle}" 
                            Padding="10,8"
                            ToolTip="Ganti Mode Gelap / Terang (Dark / Light Mode)">
                        <Grid>
                            <!-- Moon Icon when Dark -->
                            <Path Data="{StaticResource IconMoon}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform"
                                  Visibility="{Binding IsDarkMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <!-- Sun Icon when Light -->
                            <Path Data="{StaticResource IconSun}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform"
                                  Visibility="{Binding IsDarkMode, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: 5 PRIMARY METRIC KPI CARDS                                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. TEGANGAN (VOLTAGE) -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBolt}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="TEGANGAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" />
                        </StackPanel>
                        <TextBlock Text="NOMINAL 48V" FontSize="10" Foreground="{DynamicResource FgDimmed}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Voltage, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F2}" 
                                   FontSize="30" FontWeight="Black" />
                        <TextBlock Text="V" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderCardSubtle}" Margin="0,10,0,8" />
                    <Grid>
                        <TextBlock Text="MIN / MAX" FontSize="10" Foreground="{DynamicResource FgDimmed}" HorizontalAlignment="Left" />
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Right">
                            <Run Text="{Binding MinVoltage, Mode=OneWay, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" />
                            <Run Text="V / " />
                            <Run Text="{Binding MaxVoltage, Mode=OneWay, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" />
                            <Run Text="V" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. ARUS (CURRENT) -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCurrent}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="ARUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" />
                        </StackPanel>
                        <Border Background="{DynamicResource AccentMuted}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding OperatingMode}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" />
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Current, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F2}" 
                                   FontSize="30" FontWeight="Black" />
                        <TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderCardSubtle}" Margin="0,10,0,8" />
                    <Grid>
                        <TextBlock Text="DAYA (P = V x I)" FontSize="10" Foreground="{DynamicResource FgDimmed}" HorizontalAlignment="Left" />
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Right">
                            <Run Text="{Binding Power, Mode=OneWay, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" />
                            <Run Text=" W" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. SUHU (TEMPERATURE) -->
            <Border Grid.Column="4" 
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconThermometer}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="SUHU SENSOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ThermalStatus}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Temperature, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" 
                                   FontSize="30" FontWeight="Black" />
                        <TextBlock Text="°C" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderCardSubtle}" Margin="0,10,0,8" />
                    <Grid>
                        <TextBlock Text="BATAS AMAN" FontSize="10" Foreground="{DynamicResource FgDimmed}" HorizontalAlignment="Left" />
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Right">
                            <Run Text="&lt; 50.0 °C (MAX: " />
                            <Run Text="{Binding MaxTemperature, Mode=OneWay, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" />
                            <Run Text="°C)" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. STATE OF CHARGE (SOC) -->
            <Border Grid.Column="6" 
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBattery}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="SOC (CHARGE)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" />
                        </StackPanel>
                        <TextBlock Text="EST. KAPASITAS" FontSize="10" Foreground="{DynamicResource FgDimmed}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding SOC, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" 
                                   FontSize="30" FontWeight="Black" />
                        <TextBlock Text="%" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <!-- Mini Horizontal Battery Level Track -->
                    <Grid Height="4" Margin="0,12,0,8">
                        <Border Background="{DynamicResource GaugeTrackBrush}" CornerRadius="2" />
                        <Border HorizontalAlignment="Left" Background="{DynamicResource FgPrimary}" CornerRadius="2">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                    <Binding Path="SOC" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                    <Grid>
                        <TextBlock Text="STATUS KAPASITAS" FontSize="10" Foreground="{DynamicResource FgDimmed}" HorizontalAlignment="Left" />
                        <TextBlock Text="86.0 Ah / 100 Ah" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. DETEKSI KAPASITAS (Ah) -->
            <Border Grid.Column="8" 
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBattery}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="DETEKSI KAPASITAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" />
                        </StackPanel>
                        <TextBlock Text="NOMINAL 100 Ah" FontSize="10" Foreground="{DynamicResource FgDimmed}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CapacityAh, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" 
                                   FontSize="30" FontWeight="Black" />
                        <TextBlock Text="Ah" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <!-- Mini Horizontal Capacity Level Track -->
                    <Grid Height="4" Margin="0,12,0,8">
                        <Border Background="{DynamicResource GaugeTrackBrush}" CornerRadius="2" />
                        <Border HorizontalAlignment="Left" Background="{DynamicResource FgPrimary}" CornerRadius="2">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                    <Binding Path="CapacityPercentage" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                    <Grid>
                        <TextBlock Text="STATUS KAPASITAS" FontSize="10" Foreground="{DynamicResource FgDimmed}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding CapacityStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: MAIN VISUALIZATION (LEFT: CELL & ARCS, RIGHT: REAL-TIME WAVEFORM)  -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Left: Battery Cell & Gauges (~470px) -->
                <ColumnDefinition Width="470" />
                <ColumnDefinition Width="16" />
                <!-- Right: Waveform Telemetry Chart (*) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: BATTERY CELL GRAPHIC & SOH GAUGE -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Main Battery + SOH Gauges Side-by-Side -->
                        <RowDefinition Height="*" />
                        <!-- Protocol Status -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="VISUALISASI PACK BATERAI" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgSecondary}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Path Data="{StaticResource IconShieldCheck}" 
                                  Fill="{DynamicResource FgPrimary}" 
                                  Width="12" Height="12" 
                                  Stretch="Uniform" 
                                  Margin="0,0,6,0" />
                            <TextBlock Text="PROTEKSI BMS AKTIF" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Main Content: Vertical Battery (Left) + SOH Gauge & Specs (Right) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- Big Vertical Battery Column -->
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="16" />
                            <!-- Pack Specs & SOH Meter Column -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ======================================================== -->
                        <!-- 1. DYNAMIC VERTICAL BATTERY VISUALIZER                   -->
                        <!-- ======================================================== -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Positive Terminal Cap (White/Primary) -->
                            <Border Background="{DynamicResource FgPrimary}" 
                                    CornerRadius="3,3,0,0" 
                                    Width="42" Height="8" 
                                    HorizontalAlignment="Center" />

                            <!-- Battery Body (Outer Casing) -->
                            <Border BorderBrush="{DynamicResource FgPrimary}" 
                                    BorderThickness="2.5" 
                                    CornerRadius="10" 
                                    Width="110" Height="175" 
                                    Background="{DynamicResource BgCardAlt}"
                                    Padding="3">
                                <Grid>
                                    <!-- Inner Battery Fill (Slides Automatically & Changes Color Green -> Red) -->
                                    <Border Background="{Binding SOC, Converter={StaticResource SOCToBrushConverter}}" 
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom">
                                        <Border.Height>
                                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                <Binding Path="SOC" />
                                                <Binding Source="165.0" />
                                            </MultiBinding>
                                        </Border.Height>
                                    </Border>

                                    <!-- Charging Bolt Indicator (Appears when Charging) -->
                                    <Path Data="{StaticResource IconBolt}" 
                                          Fill="#FFFFFF" 
                                          Width="16" Height="16" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Top" 
                                          Margin="0,12,0,0"
                                          Opacity="0.9"
                                          Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- Percentage Pill Badge (High-Contrast Translucent Backing) -->
                                    <Border Background="#D0000000" 
                                            CornerRadius="6" 
                                            Padding="10,4" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Bottom" 
                                            Margin="0,0,0,14">
                                        <TextBlock Text="{Binding SOC, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F0, StringFormat='{}{0}%'}" 
                                                   FontWeight="Black" 
                                                   FontSize="18" 
                                                   Foreground="#FFFFFF" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Battery Level Status Subtitle -->
                            <TextBlock Text="{Binding OperatingMode}" 
                                       FontSize="9" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource FgSecondary}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- 2. RIGHT SIDE: MODULE SPECS & SOH RADIAL GAUGE           -->
                        <!-- ======================================================== -->
                        <Grid Grid.Column="2" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <!-- Technical Specs -->
                                <RowDefinition Height="Auto" />
                                <!-- Spacer -->
                                <RowDefinition Height="10" />
                                <!-- Radial SOH Gauge Card -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Module Specs Card -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource BgCardAlt}"
                                    BorderBrush="{DynamicResource BorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="MODUL TELEMETRI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgDimmed}" />
                                    <TextBlock Text="16S 48V Li-Ion / LiFePO4" FontSize="13" FontWeight="Bold" Margin="0,1,0,6" />

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Impedansi:" FontSize="10" Foreground="{DynamicResource FgSecondary}" />
                                        <TextBlock Text="11.8 mΩ" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Siklus Sel:" FontSize="10" Foreground="{DynamicResource FgSecondary}" />
                                        <TextBlock Text="142 Siklus" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Estimasi Sisa:" FontSize="10" Foreground="{DynamicResource FgSecondary}" />
                                        <TextBlock Text="~ 5.6 Jam" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Capacity Radial Gauge Card -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource BgCardAlt}"
                                    BorderBrush="{DynamicResource BorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Radial Arc -->
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="8" />
                                        <!-- Capacity Details -->
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Arc Canvas (Width 85, Height 75) -->
                                    <Grid Grid.Column="0" Width="85" Height="75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Background Track Arc -->
                                        <Path Stroke="{DynamicResource GaugeTrackBrush}" 
                                              StrokeThickness="7" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource PercentageToArcConverter}">
                                                    <Binding Source="100.0" />
                                                    <Binding Source="85.0" />
                                                    <Binding Source="7.0" />
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>
                                        <!-- Active Progress Arc -->
                                        <Path Stroke="{DynamicResource GaugeActiveBrush}" 
                                              StrokeThickness="7" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource PercentageToArcConverter}">
                                                    <Binding Path="CapacityPercentage" />
                                                    <Binding Source="85.0" />
                                                    <Binding Source="7.0" />
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>
                                        <!-- Center Readout -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-2,0,0">
                                            <TextBlock Text="{Binding CapacityAh, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" 
                                                       FontSize="15" FontWeight="Black" HorizontalAlignment="Center" />
                                            <TextBlock Text="Ah" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Capacity Info Beside Arc -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="DETEKSI KAPASITAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource FgDimmed}" />
                                        <TextBlock Text="{Binding CapacityStatus}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Margin="0,2,0,4" />
                                        <TextBlock Text="Kapasitas pack aktif terukur dari nominal 100 Ah" FontSize="9" Foreground="{DynamicResource FgSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Pack Balancing Status -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource BgCardAlt}" 
                            BorderBrush="{DynamicResource BorderCardSubtle}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12,8">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PROTOKOL:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgDimmed}" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{Binding SelectedConnectionMode}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: REAL-TIME TELEMETRY WAVEFORM GRAPH -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Chart Header & Legend -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="WAVEFORM TELEMETRI REAL-TIME" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgSecondary}" />
                            <TextBlock Text="Tren dinamika sensor 60 detik terakhir (Frekuensi sampling 5 Hz)" FontSize="11" Foreground="{DynamicResource FgDimmed}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Legend Items -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Voltage Legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Line X1="0" Y1="6" X2="20" Y2="6" Stroke="{DynamicResource WaveformVoltBrush}" StrokeThickness="2.5" Margin="0,0,6,0" />
                                <TextBlock Text="Tegangan (V)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" />
                            </StackPanel>

                            <!-- Current Legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Line X1="0" Y1="6" X2="20" Y2="6" Stroke="{DynamicResource WaveformCurrBrush}" StrokeThickness="2" StrokeDashArray="4 2" Margin="0,0,6,0" />
                                <TextBlock Text="Arus (A)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgSecondary}" />
                            </StackPanel>

                            <!-- Temperature Legend -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Line X1="0" Y1="6" X2="20" Y2="6" Stroke="{DynamicResource WaveformTempBrush}" StrokeThickness="1.5" StrokeDashArray="1 2" Margin="0,0,6,0" />
                                <TextBlock Text="Suhu (°C)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Waveform Viewport Canvas -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource BgCardAlt}"
                            BorderBrush="{DynamicResource BorderCard}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Grid Lines (Horizontal Reference Axis) -->
                            <Grid Margin="10,10,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1" />
                                <Border Grid.Row="1" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1" />
                                <Border Grid.Row="2" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1" />
                                <Border Grid.Row="3" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,0" />
                            </Grid>

                            <!-- Axis Labels on Left -->
                            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="8,8,0,8">
                                <TextBlock Text="60V / +35A" FontSize="9" Foreground="{DynamicResource FgDimmed}" />
                                <TextBlock Text="50V / +10A" FontSize="9" Foreground="{DynamicResource FgDimmed}" Margin="0,40,0,0" />
                                <TextBlock Text="45V / 0A" FontSize="9" Foreground="{DynamicResource FgDimmed}" Margin="0,40,0,0" />
                                <TextBlock Text="40V / -35A" FontSize="9" Foreground="{DynamicResource FgDimmed}" Margin="0,40,0,0" />
                            </StackPanel>

                            <!-- Real-time Polylines rendered through Viewbox for full responsiveness -->
                            <Viewbox Stretch="Fill" Margin="40,10,10,10">
                                <Canvas Width="600" Height="200" ClipToBounds="True">
                                    <!-- Temperature Curve (Dotted Fine Gray) -->
                                    <Polyline Points="{Binding TempPoints}" 
                                              Stroke="{DynamicResource WaveformTempBrush}" 
                                              StrokeThickness="1.5" 
                                              StrokeDashArray="2 2"
                                              StrokeLineJoin="Round" />

                                    <!-- Current Curve (Dashed Medium Gray) -->
                                    <Polyline Points="{Binding CurrentPoints}" 
                                              Stroke="{DynamicResource WaveformCurrBrush}" 
                                              StrokeThickness="2" 
                                              StrokeDashArray="4 2"
                                              StrokeLineJoin="Round" />

                                    <!-- Voltage Curve (Solid Crisp Primary Line) -->
                                    <Polyline Points="{Binding VoltagePoints}" 
                                              Stroke="{DynamicResource WaveformVoltBrush}" 
                                              StrokeThickness="2.5" 
                                              StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- Real-time Values Badge Bar below chart -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NILAI TERAKHIR: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgDimmed}" />
                            <TextBlock Text="V=" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" />
                            <TextBlock Text="{Binding Voltage, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F2}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="V  |  I=" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding Current, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F2}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="A  |  T=" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding Temperature, Converter={StaticResource TelemetryFormatConverter}, ConverterParameter=F1}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="°C" FontSize="10" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="TOTAL PAKET DITERIMA: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FgDimmed}" />
                            <TextBlock Text="{Binding PacketCounter, StringFormat='{}{0:N0}'}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource FgPrimary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 3: RS-232 RAW PACKET MONITOR & DIAGNOSTICS CONSOLE                    -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Console Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Console Log Text Area (Collapsible) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Console Header Bar -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTerminal}" 
                              Fill="{DynamicResource FgPrimary}" 
                              Width="13" Height="13" 
                              Stretch="Uniform" 
                              Margin="0,0,8,0" />
                        <TextBlock Text="TERMINAL LOG RAW TELEMETRY (MQTT / RS-232 STREAM)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgSecondary}" />
                        <Border Margin="10,0,0,0" Background="{DynamicResource AccentMuted}" CornerRadius="3" Padding="5,1">
                            <TextBlock Text="JSON / CSV / KEY-VALUE AUTO-DETECT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource FgSecondary}" />
                        </Border>
                    </StackPanel>

                    <!-- Console Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="BtnClearLogs_Click"
                                Content="BERSIHKAN LOG"
                                Style="{StaticResource MonoButtonStyle}" 
                                Padding="8,4" 
                                FontSize="10"
                                Margin="0,0,8,0" />
                        <Button Click="BtnToggleLog_Click"
                                Content="{Binding LogToggleText}"
                                Style="{StaticResource MonoButtonStyle}" 
                                Padding="8,4" 
                                FontSize="10" />
                    </StackPanel>
                </Grid>

                <!-- Terminal Log Viewport -->
                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Height="75"
                        Background="{DynamicResource TerminalBg}"
                        BorderBrush="{DynamicResource TerminalBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RawLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               Foreground="{DynamicResource TerminalFg}" 
                                               FontFamily="Consolas, Cascadia Code, Courier New" 
                                               FontSize="11" 
                                               Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
