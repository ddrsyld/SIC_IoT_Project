<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme (Monochrome Hitam - Putih) -->
    <SolidColorBrush x:Key="BgWindow" Color="#F4F5F8" />
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgCardHover" Color="#F9FAFB" />
    <SolidColorBrush x:Key="BgCardAlt" Color="#EAECEF" />
    <SolidColorBrush x:Key="BorderCard" Color="#DDE0E6" />
    <SolidColorBrush x:Key="BorderCardSubtle" Color="#EBEDF2" />
    
