<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme (Monochrome Hitam - Putih) -->
    <SolidColorBrush x:Key="BgWindow" Color="#08090B" />
    <SolidColorBrush x:Key="BgCard" Color="#121317" />
    <SolidColorBrush x:Key="BgCardHover" Color="#1A1C22" />
